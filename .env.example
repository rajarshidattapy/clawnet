# ClawNet environment — copy to .env and fill in. Every key is optional:
# with none set, the policy engine, sandbox, evidence memory, and decision log
# all still work fully offline.

# ── LLM (AI explanations + the ClawForge agent) ───────────────────────────────
# Used by core/llm.py for verdict explanations, and registered in TrueForge by
# `python -m clawforge setup` as the agent's model provider. Deterministic verdicts
# work even without it.
# Local or cloud. OLLAMA=yes runs everything on a local Ollama model: no cloud call and
# no cloud fallback, so nothing leaves this machine. OLLAMA=no uses the cloud provider below.
OLLAMA=no
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1

# Cloud provider: openai | anthropic | gemini | openrouter
LLM_PROVIDER=openai
LLM_API_KEY=
# Optional. Defaults: openai gpt-5.4-mini, anthropic claude-haiku-5-5,
# gemini gemini-3.6-flash, openrouter openai/gpt-5.4-mini.
# LLM_MODEL=
# LLM_BASE_URL=
# Per-provider keys also work (used when LLM_API_KEY is empty):
# OPENAI_API_KEY=  ANTHROPIC_API_KEY=  GEMINI_API_KEY=  OPENROUTER_API_KEY=
# OPENAI_REASONING_EFFORT=none
# Fallback: if the chosen cloud provider has no key or fails, retry on OpenRouter when
# OPENROUTER_API_KEY is set (and cap the agent's output so low credit still works).
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-5.4-mini
# OPENROUTER_MAX_OUTPUT_TOKENS=4096
# Cache answers on disk by prompt hash, so the same evidence costs one model call, even
# across restarts (~/.clawnet/llm_cache.json). Entries expire after the TTL.
LLM_CACHE=yes
# LLM_CACHE_TTL_SECONDS=86400
# LLM_CACHE_MAX_ENTRIES=500

# ── Observability (the /settings dashboard in the console) ────────────────────
# Every model call, tool call and human approval is traced to ~/.clawnet/traces.jsonl, with
# tokens, cost and latency. Cost = the provider's own figure when it sends one, else tokens x
# ~/.clawnet/prices.json (set with `/settings price <model> <in> <out>`). No prices are built in.
TELEMETRY=yes
# Store prompts and answers in traces (redacted, cut to 600 characters). `no` stores no text.
# TELEMETRY_CAPTURE_IO=yes
# TELEMETRY_PATH=
# TELEMETRY_MAX_MB=50

# ── ClawForge (agentic harness on TrueForge) ──────────────────────────────────
# TrueForge server: `npx @truefoundry/trueforge@latest` (Node 22.14+).
TRUEFORGE_BASE_URL=http://localhost:8790
# Optional: OpenAI model id for the ClawForge agent (other providers use LLM_MODEL).
# CLAWFORGE_MODEL=gpt-5.4-mini
# ClawForge MCP server bind address. Keep it on localhost.
CLAWFORGE_HOST=127.0.0.1
CLAWFORGE_PORT=8765
# Bearer token for the MCP server. Leave empty to auto-generate one into
# ~/.clawnet/clawforge_token (serve and setup both read it).
CLAWFORGE_TOKEN=
# Optional OAuth/JWT: also accept access tokens from your identity provider. Needs a
# JWKS URL (or a fixed key in CLAWFORGE_JWT_KEY), plus issuer and audience.
# CLAWFORGE_JWKS_URL=https://idp.example.com/.well-known/jwks.json
# CLAWFORGE_JWT_ISSUER=https://idp.example.com/
# CLAWFORGE_JWT_AUDIENCE=clawforge
# CLAWFORGE_JWT_ALGORITHMS=RS256,ES256
# Set to 1 to refuse the static token (the TrueForge connector then needs a JWT).
# CLAWFORGE_JWT_ONLY=
# Roles: viewer = observe tools, analyst = + sandbox, responder = + control tools (which still
# wait for a human). The static token (the TrueForge connector) gets CLAWFORGE_SERVICE_ROLE;
# a JWT gets the highest role in its claim, after CLAWFORGE_ROLE_MAP renames your IdP's roles.
# CLAWFORGE_SERVICE_ROLE=responder
# CLAWFORGE_ROLE_CLAIM=roles
# CLAWFORGE_ROLE_MAP=soc-lead=responder,soc-analyst=analyst,soc-intern=viewer
# CLAWFORGE_DEFAULT_ROLE=viewer
# Max seconds per agent sandbox run (TrueForge's MCP request timeout is 4 min).
CLAWFORGE_SANDBOX_TIMEOUT=180

# ── Telegram alerts + approvals ───────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Route high-risk sandbox/network approvals to Telegram (1 = on, 0 = off).
CLAWNET_TELEGRAM_APPROVAL=0
# Local mock transport for Telegram, useful for testing without a real bot (1 = on).
TELEGRAM_MOCK_ENABLED=0

# ── Threat intelligence (core/web_search.py) ──────────────────────────────────
# SerpApi key — primary live web search (Google). On a missing key, error,
# timeout or exhausted quota, search falls back to Firecrawl, then the cache.
SERPAPI_KEY=
# Firecrawl free-tier key — crawls public advisories (CISA, NVD, …) and is the
# fallback live web search.
FIRECRAWL_API_KEY=
# Seconds between background threat-intel refreshes (default 21600 = 6h).
THREAT_INTEL_INTERVAL_SECONDS=21600
# Local crawl cache path and TTL (defaults: ~/.clawnet/threat_cache.json, 6h).
CLAWNET_THREAT_CACHE_PATH=
CLAWNET_THREAT_CACHE_TTL_SECONDS=21600

# ── Supermemory Local — semantic evidence/threat search ───────────────────────
# Run the server with: bash scripts/supermemory-local.sh  (prints the sm_ key).
# Without it, the JSONL evidence store remains the source of truth.
SUPERMEMORY_API_URL=http://localhost:6767

# ── Sandbox: Daytona (primary) · Docker (fallback) ────────────────────────────
# With a key set, every sandbox run happens in an ephemeral Daytona sandbox.
# Without it (or if Daytona fails), ClawNet falls back to local Docker.
DAYTONA_API_KEY=
# DAYTONA_API_URL=https://app.daytona.io/api
# DAYTONA_TARGET=us
# Force a backend: daytona | docker
# CLAWNET_SANDBOX_BACKEND=
# 1 = keep the Daytona sandbox after the run (visible in the Daytona dashboard,
# auto-deleted after 30 minutes)
CLAWNET_DAYTONA_KEEP=0

# ── Sandbox ───────────────────────────────────────────────────────────────────
# Where approved sandbox projects are promoted (default ~/clawnet-workspace).
CLAWNET_HOST_WORKSPACE=

# ── Testing (internal) ────────────────────────────────────────────────────────
# Deterministic record/replay of the agent's model calls: off | record | replay.
CLAWNET_REPLAY=off
